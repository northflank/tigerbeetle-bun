{
  "apiVersion": "v1.2",
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "tigerbeetle",
            "region": "europe-west"
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "SecretGroup",
                "spec": {
                  "name": "tbe",
                  "projectId": "tigerbeetle",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "secrets": {
                    "variables": {
                      "DATA_FOLDER": "/",
                      "TOTAL_REPLICAS": "3",
                      "ORDERED_REPLICAS": "tb01,tb02,tb03"
                    },
                    "files": {
                      "/init.sh": {
                        "data": "",
                        "encoding": "utf-8"
                      }
                    }
                  },
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": []
                  }
                }
              },
              {
                "kind": "DeploymentService",
                "spec": {
                  "deployment": {
                    "instances": 1,
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 1024
                      },
                      "shmSize": 64
                    },
                    "docker": {
                      "configType": "customEntrypointCustomCommand",
                      "customEntrypoint": "ash -c",
                      "customCommand": "\"chmod +x /init.sh && /init.sh\""
                    },
                    "external": {
                      "imagePath": "ghcr.io/tigerbeetle/tigerbeetle:latest"
                    },
                    "metadata": {
                      "labels": {},
                      "annotations": {}
                    }
                  },
                  "name": "tb-single",
                  "projectId": "tigerbeetle",
                  "billing": {
                    "deploymentPlan": "nf-compute-200"
                  },
                  "ports": [
                    {
                      "name": "p01",
                      "internalPort": 3000,
                      "protocol": "TCP",
                      "security": {
                        "credentials": [],
                        "policies": [],
                        "sso": {}
                      },
                      "domains": [],
                      "disableNfDomain": false
                    }
                  ],
                  "runtimeEnvironment": {
                    "REPLICA_NUMBER": "0",
                    "ORDERED_REPLICAS": "tb-single",
                    "TOTAL_REPLICAS": "1"
                  },
                  "runtimeFiles": {}
                },
                "ref": "tb-single"
              },
              {
                "kind": "Volume",
                "spec": {
                  "spec": {
                    "storageSize": 5120,
                    "storageClassName": "ssd",
                    "accessMode": "ReadWriteOnce"
                  },
                  "name": "tb-single-data",
                  "mounts": [
                    {
                      "containerMountPath": "/data",
                      "volumeMountPath": ""
                    }
                  ],
                  "attachedObjects": [
                    {
                      "id": "tb-single",
                      "type": "service"
                    }
                  ]
                },
                "ref": "tb-single-data"
              },
              {
                "kind": "CombinedService",
                "spec": {
                  "name": "tb-bun",
                  "projectId": "tigerbeetle",
                  "billing": {
                    "buildPlan": "nf-compute-400-16",
                    "deploymentPlan": "nf-compute-100-1"
                  },
                  "deployment": {
                    "instances": 1,
                    "metadata": {
                      "labels": {},
                      "annotations": {}
                    }
                  },
                  "ports": [
                    {
                      "name": "site",
                      "internalPort": 3000,
                      "public": true,
                      "security": {
                        "securePathConfiguration": {
                          "rules": []
                        }
                      },
                      "protocol": "HTTP",
                      "domains": []
                    }
                  ],
                  "buildSource": "git",
                  "vcsData": {
                    "projectUrl": "https://github.com/northflank/tigerbeetle-bun",
                    "projectType": "github",
                    "projectBranch": "master",
                    "accountLogin": "northflank"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "kaniko",
                      "useCache": false,
                      "dockerFilePath": "/Dockerfile",
                      "dockerWorkDir": "/"
                    }
                  },
                  "runtimeEnvironment": {
                    "TB_PORT": "3000",
                    "TB_ADDRESSES": "tb-single"
                  },
                  "disabledCI": false,
                  "buildConfiguration": {
                    "pathIgnoreRules": [],
                    "isAllowList": false,
                    "ciIgnoreFlagsEnabled": false
                  },
                  "buildArguments": {}
                }
              }
            ]
          }
        }
      ]
    }
  },
  "name": "tb-bun",
  "description": "",
  "options": {
    "autorun": false,
    "concurrencyPolicy": "allow",
    "runOnUpdate": false
  },
  "gitops": {
    "repoUrl": "https://github.com/northflank/tigerbeetle-bun",
    "vcsService": "github",
    "accountLogin": "northflank",
    "branch": "master",
    "filePath": "/northflank-template.json"
  },
  "$schema": "https://api.northflank.com/v1/schemas/template"
}